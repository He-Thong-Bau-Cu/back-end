        <!-- Notes -->
        <mxCell id="note1" value="USE CASES SUPPORTED:&#xa;&#xa;1. Create Document&#xa;   - Upload document metadata to database&#xa;   - Store document title, content, type&#xa;   - Link to election and prepared by participant&#xa;   - Set initial status and remarks&#xa;&#xa;2. View Documents&#xa;   - View document by ID with full details&#xa;   - List all documents by election&#xa;   - List documents created by specific user&#xa;   - Populate election, participant, user references&#xa;&#xa;3. Update Document&#xa;   - Update document metadata&#xa;   - Change title, content, file URL&#xa;   - Update status and remarks&#xa;   - Track who updated and when&#xa;&#xa;4. Delete Documents&#xa;   - Soft delete by status change&#xa;   - Hard delete from MinIO storage&#xa;   - Remove file references&#xa;&#xa;5. Upload Document&#xa;   - Upload file to MinIO storage&#xa;   - Support multiple file types&#xa;   - Encrypt files if needed&#xa;   - Generate unique file names&#xa;   - Return file URL and metadata&#xa;   - Support signed documents&#xa;&#xa;FILE STORAGE:&#xa;- Files stored in MinIO (S3-compatible)&#xa;- Path structure: fileType/userId/fileName&#xa;- Supports encryption for sensitive files&#xa;- Generates presigned URLs for secure access&#xa;- Automatic unique file naming with UUID" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFFACD;strokeColor=#F9A825;align=left;fontSize=10;size=15;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="40" y="500" width="320" height="720" as="geometry"/>
        </mxCell>
        <mxCell id="edge-note1" value="" style="endArrow=none;dashed=1;html=1;dashPattern=1 3;strokeWidth=2;strokeColor=#F9A825;entryX=0;entryY=0.5;entryDx=0;entryDy=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;" edge="1" parent="1" source="note1" target="election-documents-service">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

