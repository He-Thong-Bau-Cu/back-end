        <mxCell id="edge5" value="electionId" style="endArrow=open;endFill=0;endSize=12;html=1;strokeWidth=2;strokeColor=#388E3C;entryX=0;entryY=0.5;entryDx=0;entryDy=0;exitX=1;exitY=0.25;exitDx=0;exitDy=0;" edge="1" parent="1" source="election-documents-model" target="elections-model">
