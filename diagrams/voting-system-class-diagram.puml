@startuml Voting System Class Diagram

' =====================================
' COLOR DEFINITIONS
' =====================================
!define CONTROLLER_COLOR #E3F2FD
!define SERVICE_COLOR #FFF3E0
!define MODEL_COLOR #E8F5E9
!define DTO_COLOR #F3E5F5
!define UTILITY_COLOR #FFF9C4

' =====================================
' CONTROLLERS
' =====================================

class BallotsController <<Controller>> CONTROLLER_COLOR {
  - ballotsService: BallotsService
  + getById(id: string): BaseResponse
  + getBallotsByElectionId(electionId: string): BaseResponse
  + getBallotsByVoterId(voterId: string): BaseResponse
  + getCastBallotsByVoterId(voterId: string): BaseResponse
  + getStatistics(electionId: string): BaseResponse
  + create(createBallotDto: CreateBallotDto, userId: string): BaseResponse
  + update(id: string, updateBallot: UpdateBallotDto, userId: string): BaseResponse
  + delete(id: string): BaseResponse
  + updateStatus(id: string, userId: string): BaseResponse
  + searchBallots(req: BaseSearchDTO): BaseResponse
  + getBallotPDF(id: string): void
  + signBallot(fileP12: File, id: string, password: string, userId: string): BaseResponse
  + verifyOtp(id: string, verifyOtpDto: VerifyOtpDto): BaseResponse
}

class VotersController <<Controller>> CONTROLLER_COLOR {
  - votersService: VotersService
  + search(req: BaseSearchDTO): BaseResponse
  + create(createVoter: CreateVoterDto, userId: string): BaseResponse
  + update(id: string, updateVoter: UpdateVoterDto, userId: string): BaseResponse
  + updateStatus(id: string, status: string, userId: string): BaseResponse
  + getEligibleVoters(electionId: string): BaseResponse
  + delete(id: string): BaseResponse
}

class ResultsController <<Controller>> CONTROLLER_COLOR {
  - resultsService: ResultsService
  + search(req: BaseSearchDTO): BaseResponse
  + getById(id: string): BaseResponse
  + getByElectionId(electionId: string): BaseResponse
  + createAndSign(p12File: File, password: string, electionId: string, userId: string): BaseResponse
  + confirmResults(electionId: string, userId: string): BaseResponse
}

' =====================================
' SERVICES
' =====================================

class BallotsService <<Service>> SERVICE_COLOR {
  - ballotsModel: Model<Ballots>
  - electionsModel: Model<Elections>
  - votersModel: Model<Voters>
  - electionEntitiesModel: Model<ElectionEntities>
  - votingRightsModel: Model<VotingRights>
  - electionTypesModel: Model<ElectionTypes>
  - usersModel: Model<Users>
  - notificationService: NotificationService
  + getById(id: string): Ballots
  + getByElectionId(electionId: string): Ballots[]
  + getByVoterId(voterId: string): Ballots[]
  + getByVoterAndCast(voterId: string): Ballots[]
  + create(createBallot: CreateBallotDto, userId: string): Ballots
  + update(id: string, updateBallot: UpdateBallotDto, userId: string): Ballots
  + updateStatus(id: string, userId: string): Ballots
  + delete(id: string): Ballots
  + getStatistics(electionId: string): Object
  + searchBallots(req: BaseSearchDTO): Ballots[]
  + generateBallotPDF(id: string): Buffer
  + signBallot(fileP12: File, id: string, password: string, userId: string): string
  + verifyOtp(id: string, verifyOtpDto: VerifyOtpDto): boolean
  + activateBallot(id: string, userId: string): Ballots
  + disableBallot(id: string, userId: string): Ballots
  + submitVote(id: string, allocations: Allocation[], userId: string): Ballots
  + getVoteHistory(voterId: string): Ballots[]
}

class VotersService <<Service>> SERVICE_COLOR {
  - voterModel: Model<Voters>
  - electionsModel: Model<Elections>
  - userModel: Model<Users>
  - votingRightsModel: Model<VotingRights>
  - electionParticipantsModel: Model<ElectionsParticipants>
  - rolesModel: Model<Roles>
  + search(req: BaseSearchDTO): Voters[]
  + create(createVoter: CreateVoterDto, userId: string): Voters
  + update(id: string, updateVoter: UpdateVoterDto, userId: string): Voters
  + updateStatus(id: string, status: string, userId: string): Voters
  + delete(id: string): Voters
  + getEligibleVoters(electionId: string): Voters[]
  + confirmParticipation(voterId: string, userId: string): Voters
}

class ResultsService <<Service>> SERVICE_COLOR {
  - resultsModel: Model<Results>
  - electionsModel: Model<Elections>
  - electionEntitiesModel: Model<ElectionEntities>
  - ballotsModel: Model<Ballots>
  - votingMethodsModel: Model<VotingMethods>
  - electionDocumentsModel: Model<ElectionDocuments>
  - electionsParticipantsModel: Model<ElectionsParticipants>
  - signingService: SigningService
  - minioService: MinioService
  - mailService: MailService
  + search(req: BaseSearchDTO): Results[]
  + getById(id: string): Results
  + getByElectionId(electionId: string): Results[]
  + createAndSign(p12File: File, password: string, electionId: string, userId: string): Results
  + getWinnersCumulative(electionId: string): Results[]
  + getWinnersYesNo(electionId: string): Results[]
  + confirmResults(electionId: string, userId: string): Results[]
  + viewVotingProcess(electionId: string): Object
}

class SigningService <<Utility>> UTILITY_COLOR {
  + signPdfWithP12(pdfBuffer: Buffer, p12Buffer: Buffer, passphrase: string): Buffer
  + signDocxWithP12(docBuffer: Buffer, p12Buffer: Buffer, passphrase: string): Buffer
  + signDocxXml(docBuffer: Buffer, p12Buffer: Buffer, passphrase: string): Buffer
  + verifyPdfSignature(pdfBuffer: Buffer): boolean
  + verifyDocxSignature(docxBuffer: Buffer): boolean
}

class NotificationService <<Utility>> UTILITY_COLOR {
  + transferDataRealTime(electionId: string, data: Object): void
  + sendNotification(userId: string, message: string): void
}

class MinioService <<Utility>> UTILITY_COLOR {
  + uploadFile(file: File, bucketName: string): string
  + downloadFile(fileName: string, bucketName: string): Buffer
  + deleteFile(fileName: string, bucketName: string): boolean
}

class MailService <<Utility>> UTILITY_COLOR {
  + sendEmail(to: string, subject: string, content: string): void
  + sendResultNotification(electionId: string): void
}

' =====================================
' MODELS / SCHEMAS
' =====================================

class Ballots <<Entity>> MODEL_COLOR {
  + _id: ObjectId
  + electionId: ObjectId
  + voterId: ObjectId
  + allocations: Allocation[]
  + otpCode: string
  + signature: string
  + attempts: number
  + status: string
  + issuedAt: Date
  + castAt: Date
  + createdAt: Date
  + updatedAt: Date
  + createdBy: ObjectId
  + updatedBy: ObjectId
}

class Allocation <<ValueObject>> MODEL_COLOR {
  + entityId: ObjectId
  + voteValue: number
}

class Voters <<Entity>> MODEL_COLOR {
  + _id: ObjectId
  + electionId: ObjectId
  + userId: ObjectId
  + eligible: boolean
  + status: string
  + createdAt: Date
  + updatedAt: Date
  + createdBy: ObjectId
  + updatedBy: ObjectId
}

class Results <<Entity>> MODEL_COLOR {
  + _id: ObjectId
  + electionId: ObjectId
  + entityId: ObjectId
  + votesCount: number
  + isFinal: boolean
  + status: string
  + createdAt: Date
  + updatedAt: Date
  + createdBy: ObjectId
  + updatedBy: ObjectId
}

class Elections <<Entity>> MODEL_COLOR {
  + _id: ObjectId
  + title: string
  + typeId: ObjectId
  + votingMethodId: ObjectId
  + thresholdId: ObjectId
  + startDate: Date
  + endDate: Date
  + timeline: Object
  + stages: Object
  + delegationStart: Date
  + delegationEnd: Date
  + status: string
  + statusData: string
  + decisionNumber: string
  + decisionName: string
  + rejectReason: string
  + createdAt: Date
  + updatedAt: Date
  + createdBy: ObjectId
  + updatedBy: ObjectId
}

class Users <<Entity>> MODEL_COLOR {
  + _id: ObjectId
  + username: string
  + fullName: string
  + email: string
  + phone: string
  + position: string
  + department: string
  + password: string
  + status: string
  + createdAt: Date
  + updatedAt: Date
}

class ElectionEntities <<Entity>> MODEL_COLOR {
  + _id: ObjectId
  + electionId: ObjectId
  + electionTypeId: ObjectId
  + title: string
  + description: string
  + metaData: Object
  + fileUrl: string
  + proposerId: ObjectId
  + status: string
  + createdAt: Date
  + updatedAt: Date
  + createdBy: ObjectId
  + updatedBy: ObjectId
}

class VotingRights <<Entity>> MODEL_COLOR {
  + _id: ObjectId
  + voterId: ObjectId
  + electionId: ObjectId
  + shares: number
  + votes: number
  + createdAt: Date
  + updatedAt: Date
}

class ElectionsParticipants <<Entity>> MODEL_COLOR {
  + _id: ObjectId
  + electionId: ObjectId
  + userId: ObjectId
  + roleId: string
  + position: string
  + createdAt: Date
  + updatedAt: Date
}

class ElectionTypes <<Entity>> MODEL_COLOR {
  + _id: ObjectId
  + typeCode: string
  + typeName: string
  + description: string
  + status: string
  + createdAt: Date
  + updatedAt: Date
}

class VotingMethods <<Entity>> MODEL_COLOR {
  + _id: ObjectId
  + methodCode: string
  + methodName: string
  + description: string
  + status: string
  + createdAt: Date
  + updatedAt: Date
}

class Thresholds <<Entity>> MODEL_COLOR {
  + _id: ObjectId
  + thresholdCode: string
  + thresholdName: string
  + value: number
  + description: string
  + status: string
  + createdAt: Date
  + updatedAt: Date
}

class ElectionDocuments <<Entity>> MODEL_COLOR {
  + _id: ObjectId
  + electionId: ObjectId
  + documentType: string
  + fileName: string
  + fileUrl: string
  + signature: string
  + status: string
  + createdAt: Date
  + updatedAt: Date
}

class Roles <<Entity>> MODEL_COLOR {
  + _id: ObjectId
  + roleName: string
  + roleCode: string
  + permissions: string[]
  + status: string
  + createdAt: Date
  + updatedAt: Date
}

' =====================================
' DTOs
' =====================================

class CreateBallotDto <<DTO>> DTO_COLOR {
  + electionId: string
  + voterId: string
  + allocations: Allocation[]
}

class UpdateBallotDto <<DTO>> DTO_COLOR {
  + electionId: string
  + voterId: string
  + allocations: Allocation[]
  + status: string
}

class CreateVoterDto <<DTO>> DTO_COLOR {
  + electionId: string
  + userId: string
  + eligible: boolean
  + status: string
}

class UpdateVoterDto <<DTO>> DTO_COLOR {
  + eligible: boolean
  + status: string
}

class VerifyOtpDto <<DTO>> DTO_COLOR {
  + otpCode: string
}

class BaseSearchDTO <<DTO>> DTO_COLOR {
  + keyword: string
  + page: number
  + limit: number
}

class BaseResponse <<DTO>> DTO_COLOR {
  + success: boolean
  + data: any
  + message: string
  + statusCode: number
}

' =====================================
' RELATIONSHIPS
' =====================================

' Controller -> Service relationships
BallotsController --> BallotsService : uses
VotersController --> VotersService : uses
ResultsController --> ResultsService : uses

' Service -> Service relationships
BallotsService --> NotificationService : uses
ResultsService --> SigningService : uses
ResultsService --> MinioService : uses
ResultsService --> MailService : uses

' Service -> Model relationships
BallotsService --> Ballots : manages
BallotsService --> Elections : reads
BallotsService --> Voters : reads
BallotsService --> ElectionEntities : reads
BallotsService --> VotingRights : reads
BallotsService --> ElectionTypes : reads
BallotsService --> Users : reads

VotersService --> Voters : manages
VotersService --> Elections : reads
VotersService --> Users : reads
VotersService --> VotingRights : reads
VotersService --> ElectionsParticipants : manages
VotersService --> Roles : reads

ResultsService --> Results : manages
ResultsService --> Elections : reads
ResultsService --> ElectionEntities : reads
ResultsService --> Ballots : reads
ResultsService --> VotingMethods : reads
ResultsService --> ElectionDocuments : manages

' Model relationships
Ballots "1" --> "1" Elections : belongs to
Ballots "1" --> "1" Voters : belongs to
Ballots "1" --> "*" Allocation : contains
Allocation "1" --> "1" ElectionEntities : references

Voters "1" --> "1" Elections : belongs to
Voters "1" --> "1" Users : references

Results "1" --> "1" Elections : belongs to
Results "1" --> "1" ElectionEntities : belongs to

VotingRights "1" --> "1" Voters : belongs to
VotingRights "1" --> "1" Elections : belongs to

ElectionsParticipants "1" --> "1" Elections : belongs to
ElectionsParticipants "1" --> "1" Users : references

Elections "1" --> "1" ElectionTypes : has type
Elections "1" --> "1" VotingMethods : has method
Elections "1" --> "1" Thresholds : has threshold
Elections "1" --> "1" Users : created by

ElectionEntities "1" --> "1" Elections : belongs to
ElectionEntities "1" --> "1" ElectionTypes : has type
ElectionEntities "1" --> "1" Users : proposed by

ElectionDocuments "1" --> "1" Elections : belongs to

Users "1" --> "1" Roles : has role

' DTO relationships
BallotsController --> CreateBallotDto : receives
BallotsController --> UpdateBallotDto : receives
BallotsController --> VerifyOtpDto : receives
BallotsController --> BaseSearchDTO : receives
BallotsController --> BaseResponse : returns

VotersController --> CreateVoterDto : receives
VotersController --> UpdateVoterDto : receives
VotersController --> BaseSearchDTO : receives
VotersController --> BaseResponse : returns

ResultsController --> BaseSearchDTO : receives
ResultsController --> BaseResponse : returns

CreateBallotDto --> Allocation : contains

note right of BallotsService
  <b>Use Cases Supported:</b>
  • Activate ballot functionality
  • Ballot disable functionality
  • View vote history functionality
  • Selection vote content functionality
  • Submit vote functionality
  • Digital signature on ballot functionality
end note

note right of VotersService
  <b>Use Cases Supported:</b>
  • Add voter functionality
  • View voter list functionality
  • Update voter list functionality
  • Delete voter list functionality
  • Confirm to participation functionality
end note

note right of ResultsService
  <b>Use Cases Supported:</b>
  • View vote result functionality
  • Confirmation of voting results functionality
  • View voting process functionality
end note

@enduml
